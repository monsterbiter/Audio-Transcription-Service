# 环境变量配置文件
# 复制此文件为 .env 并填入真实的配置值

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=audio_transcription

# 服务端口
SERVER_PORT=8080

# 科大讯飞语音识别配置
IFLYTEK_APP_ID=your_appid
IFLYTEK_API_KEY=your_apikey
IFLYTEK_API_SECRET=your_apisecret
IFLYTEK_WS_URL=wss://iat-api.xfyun.cn/v2/iat

# LLM API 配置
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_API_KEY=your_llm_apikey
LLM_MODEL=agnes-25-flash

# 文件存储目录
UPLOAD_DIR=./uploads
